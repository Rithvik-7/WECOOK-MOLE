MOLE_OPERATOR_TOKEN=replace-with-a-long-random-token
MOLE_DB=data/mole.db
MOLE_PUBLIC_URL=http://127.0.0.1:3000
# Next.js server-side proxy target. Keep device credentials out of NEXT_PUBLIC variables.
MOLE_API_INTERNAL=http://127.0.0.1:8000
# Mole uses Groq's free API. No credit card. Create a key at
# https://console.groq.com/keys and paste it here.
GROQ_API_KEY=
MOLE_LLM_MODEL=qwen/qwen3.8-27b
# Optional alternatives, used only when GROQ_API_KEY is empty:
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# MOLE_LLM_BASE_URL=
# MOLE_LLM_API_KEY=
# Local Ollama only if you set this:
# MOLE_LLM_BACKEND=ollama
# MOLE_OLLAMA_HOST=http://127.0.0.1:11434
